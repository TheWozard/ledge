package components

import (
	"regexp"
	"strings"
	"time"
	"unicode"
)

// Message is a Basic card for a message, such as a chat or an email: a line of its
// avatar, who it's From and when it was Sent, then its title (such as its subject or
// channel), and its description, the start of it. Its kind is "message".
type Message struct {
	Basic
	From string
	// Avatar is a picture of who it's from, as a data: URL of a PNG, JPEG, GIF, WebP
	// or SVG image, base64; anything else, "" included, shows From's initials. The
	// page can fetch nothing, so no other URL could show, and it mustn't try.
	Avatar string
	Sent   time.Time // or the zero Time, to show none
}

// Frame is the frame of the message's Basic card, of the kind "message".
func (m Message) Frame() Frame {
	f := m.Basic.Frame()
	f.Kind = "message"
	return f
}

// Body is the message's avatar, sender and time, then its title and description.
func (m Message) Body() templ.Component { return messageBody(m) }

// dataImage is a data: URL of an image, base64, that an avatar can be.
var dataImage = regexp.MustCompile(`^data:image/(png|jpeg|gif|webp|svg\+xml);base64,[A-Za-z0-9+/]+={0,2}$`)

// avatar is the message's Avatar if it's a data: URL of an image, or "".
func (m Message) avatar() string {
	if dataImage.MatchString(m.Avatar) {
		return m.Avatar
	}
	return ""
}

// initials is the first letter of each of name's first two words, in upper case:
// "Ada Lovelace" is "AL", and "" is "?".
func initials(name string) string {
	var letters []rune
	for _, word := range strings.Fields(name) {
		for _, r := range word {
			if unicode.IsLetter(r) || unicode.IsDigit(r) {
				letters = append(letters, unicode.ToUpper(r))
				break
			}
		}
		if len(letters) == 2 {
			break
		}
	}
	if len(letters) == 0 {
		return "?"
	}
	return string(letters)
}

// sentAt is when a message was sent as the card shows it: the time, such as "3:04 PM",
// if it was today, or the day and time, such as "Mon 3:04 PM", within the week, or
// the date, such as "Jan 2", before that.
func sentAt(sent, now time.Time) string {
	sent = sent.In(now.Location())
	y, m, d := now.Date()
	today := time.Date(y, m, d, 0, 0, 0, 0, now.Location())
	switch {
	case !sent.Before(today):
		return sent.Format(time.Kitchen)
	case !sent.Before(today.AddDate(0, 0, -6)):
		return sent.Format("Mon " + time.Kitchen)
	}
	return sent.Format("Jan 2")
}

// messageBody is a Message's body: a line of its avatar, an image or its sender's
// initials, its sender, and when it was sent, then its title and description.
templ messageBody(m Message) {
	<div class="message-head">
		if src := m.avatar(); src != "" {
			<img class="avatar" src={ templ.SafeURL(src) } alt=""/>
		} else {
			<span class="avatar" aria-hidden="true">{ initials(m.From) }</span>
		}
		<span class="from">{ m.From }</span>
		if !m.Sent.IsZero() {
			<time class="sent" datetime={ m.Sent.Format(time.RFC3339) }>{ sentAt(m.Sent, time.Now()) }</time>
		}
	</div>
	if m.Title != "" {
		<span class="title">{ m.Title }</span>
	}
	if m.Description != "" {
		<div class="description">{ m.Description }</div>
	}
}
