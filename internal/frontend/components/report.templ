package components

// ReportPage is the report window's page, styled by themeCSS (a theme.Theme's
// Report): title in the title bar the page draws, and blocks under it, top to
// bottom, scrolling under the title bar. A block is any component; the ones in
// blocks.templ are Heading, Paragraph, Fields, Table, List, Code, Note and Link. Its
// layout is page/report.css, and its script page/report.js.
//
// The page can't talk to the app. All it can ask of its window, through its "frame"
// handler (see the shim), is: a mouse-down on the title bar starts a drag (the second
// of a double-click zooms), and the title bar's buttons, when a theme shows them,
// close, minimise and zoom it. A Link is a real <a>; clicking one asks the window to
// navigate, which the app decides on.
templ ReportPage(themeCSS string, title string, blocks []templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			@style(reportCSS)
			@style(themeCSS)
		</head>
		<body>
			<header class="titlebar"><span>{ title }</span><button class="minimise" title="Minimise" aria-label="Minimise"></button><button class="zoom" title="Zoom" aria-label="Zoom"></button><button class="close" title="Close" aria-label="Close"></button></header>
			<main tabindex="-1">
				<article>
					for _, block := range blocks {
						@block
					}
				</article>
			</main>
			@script(reportJS)
		</body>
	</html>
}
