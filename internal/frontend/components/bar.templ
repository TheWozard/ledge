package components

import "fmt"

// BarPage is the bar's page, styled by themeCSS (theme.CSS for theme.Bar), for a bar
// along edge: "top" or "bottom". Its #app is empty until it's given BarContent: it
// posts {action: "ready"} once loaded, and from then takes update(html), with html
// rendered from BarContent, and morphs what it shows into it: only what's changed is
// touched, so a card or action that's still there keeps its element, hover and
// scroll.
//
// The page posts to window.webkit.messageHandlers.ledge only {action: "click", id}
// when something clickable is clicked: a card, its ×, or an action. The id is
// the one Clicks has for its Click; the page never holds anything but ids.
templ BarPage(themeCSS string, edge string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<style>
	/* Layout only. How the bar looks comes from its theme, added after this, so a
	   theme's rules win over these. A theme sets --bar to an opaque colour for the
	   page behind the bar, and --c-green, --c-yellow, --c-red, --c-blue and --c-gray
	   for actions.

	   A card's kind is a class on its <li>, such as basic, for a theme to style
	   each kind by. A timer card has --progress, from 0 to 1 as it counts down, and
	   data-done once it's up. A card with a colour carries it in data-color, and as CSS in --card-color; a
	   theme shows it however it likes, or not at all. An action carries its
	   current colour in data-color, and as CSS in --action.

	   Entering and leaving: a card new since the last render, or an action new
	   to a card that was already there, has data-new and --i, its place among the new
	   ones of its kind, for an entrance animation; the next render takes them off. A
	   new card's actions arrive with it, so aren't marked. An entrance should
	   fill backwards, not both: it ends at how the element looks anyway, and WebKit
	   can hold a stepped one a step short of its end. Each render morphs the page
	   rather than replacing it, so that only plays for what's really new. A card or
	   action that's gone stays, with data-leaving, until its animations end,
	   then goes. A theme's exit should end with "collapse", which closes up the space
	   it leaves so what follows slides into place; without one, it just collapses. */
	* { box-sizing: border-box; }
	html, body { margin: 0; height: 100%; background: var(--bar); overflow: hidden; }
	/* The bar stays put against the window's edges: no rubber-band bounce. */
	html { overscroll-behavior: none; }
	body { -webkit-user-select: none; cursor: default; }

	/* The bar fills the window with the scrolling row of cards. A theme sets its padding
	   with --pad-top, --pad-x and --pad-bottom. */
	#app { --pad-top: 8px; --pad-x: 8px; --pad-bottom: 8px;
	       position: relative; display: flex; height: 100%; gap: 8px;
	       padding: var(--pad-top) var(--pad-x) var(--pad-bottom); }

	/* The row of cards runs through the bar's side padding to the window's edges, padded
	   the same inside, so the cards rest inside the padding but scroll out to the edge,
	   not cut off short of it. A theme pads the row further sideways with --row-pad-x,
	   not padding-inline, which this sets. */
	ul { flex: 1; min-width: 0; list-style: none; margin: 0 calc(-1 * var(--pad-x)); padding: 0; display: flex; gap: 8px;
	     overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
	#cards { padding-inline: calc(var(--pad-x) + var(--row-pad-x, 0px)); }
	ul::-webkit-scrollbar { display: none; }
	/* A card is --card-width wide: a theme sets it, for every card or by kind, and a
	   card with a Width of its own has it inline, which wins. */
	li { position: relative; flex: none; width: var(--card-width, 280px); height: 100%; display: flex; flex-direction: column; overflow: hidden; }
	/* Anything with a Click has the class clickable, and is clicked on its own: a
	   clickable action isn't also a click on its card. */
	.clickable { cursor: pointer; }
	/* Title, description, then the actions pinned to the bottom. The title
	   clamps; the description fills the space between it and the actions (or
	   the bottom, without them), and scrolls if it doesn't fit. */
	/* Only the title shares the top line with ×, so only it keeps clear of it. */
	.title { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; -webkit-line-clamp: 2; flex: none;
	         margin-right: 16px; }
	.description { flex: 1 1 0; min-height: 0; overflow-x: hidden; overflow-y: auto; }

	/* A card's actions sit in one row at its bottom, inside the card's padding,
	   and scroll sideways if they don't fit. A theme spaces them from the description
	   above, such as with a gap on the card. A theme whose card has no padding of its
	   own, its lines padding themselves, pads the row the same. A clickable one is a
	   button of its own; clicking one that isn't is clicking the card. */
	.actions { flex: none; display: flex; gap: 4px; margin-top: auto;
	                 overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
	.actions::-webkit-scrollbar { display: none; }
	.action { position: relative; flex: none; display: flex; align-items: center; height: 20px;
	                padding: 0 8px; white-space: nowrap; }

	.dismiss { position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; border: 0; padding: 0;
	           background: none; color: inherit; font: inherit; cursor: pointer; }

	.empty { flex: 1; display: flex; align-items: center; }
	/* The row, and a card's actions, are always there, so the last of them can
	   leave; empty, they're hidden, and "No events." shows once the last card has gone. */
	.actions:empty, ul:empty { display: none; }
	ul:not(:empty) ~ .empty { display: none; }

	/* --collapse-x is set on a leaving element to minus the room it takes in its row,
	   gap included. */
	[data-leaving] { pointer-events: none; animation: collapse .2s ease-in-out both; }
	@keyframes collapse { to { margin-right: var(--collapse-x, 0); } }
	@keyframes blink { 50% { opacity: 0; } }
			</style>
			@templ.Raw("<style>\n" + themeCSS + "</style>")
		</head>
		<body class={ edge }>
			<div id="app"></div>
			@templ.Raw("<script>" + idiomorph + "</script>")
			<script>
	const app = document.getElementById("app");

	// Everything the page tells the app: an action, and the id it applies to.
	function send(action, id) {
	  window.webkit.messageHandlers.ledge.postMessage(id == null ? { action } : { action, id });
	}

	// update shows html, rendered by Go from BarContent, with its text escaped. It
	// morphs #app into it, matching cards and actions by their ids, so what's
	// still there keeps its element: the row keeps its scroll, a hovered card its hover,
	// and a clicked action its flash: "clicked" is the page's own class, not in
	// html, so it's carried over rather than morphed away. A card or action that's
	// gone leaves rather than vanishing.
	function update(html) {
	  Idiomorph.morph(app, html, {
	    morphStyle: "innerHTML",
	    callbacks: {
	      beforeNodeMorphed(from, to) {
	        if (from.classList?.contains("clicked")) to.classList.add("clicked");
	      },
	      beforeNodeRemoved(node) {
	        if (!node.matches?.("#cards > li, #cards .actions > .action")) return true;
	        if (!node.hasAttribute("data-leaving")) leave(node);
	        return false;
	      },
	    },
	  });
	  tick();
	}

	// leave marks node data-leaving, with the room it takes, and removes it once its
	// theme's animations end; or after a few seconds regardless, as a hidden window's
	// may not run. If it comes back first, a render morphs it back into place, taking
	// data-leaving off, and it stays.
	function leave(node) {
	  node.removeAttribute("data-new");
	  node.classList.remove("clicked");
	  const gap = parseFloat(getComputedStyle(node.parentElement).columnGap) || 0;
	  node.style.setProperty("--collapse-x", -(node.offsetWidth + gap) + "px");
	  node.setAttribute("data-leaving", "");
	  const leaving = node.leaving = {};
	  const gone = () => {
	    if (node.leaving === leaving && node.hasAttribute("data-leaving")) node.remove();
	  };
	  const ending = node.getAnimations().filter(a => a.effect?.getComputedTiming().endTime !== Infinity);
	  Promise.all(ending.map(a => a.finished)).then(gone, gone);
	  setTimeout(gone, 3000);
	}

	// A click on anything with data-click posts its id: the innermost, so an
	// action's click isn't also its card's. A clicked action has the class
	// clicked for a theme to flash it, restarting if it's clicked again quickly.
	app.addEventListener("click", event => {
	  const target = event.target.closest("[data-click]");
	  if (!target) return;
	  if (target.classList.contains("action")) {
	    target.classList.remove("clicked");
	    void target.offsetWidth;
	    target.classList.add("clicked");
	  }
	  send("click", target.dataset.click);
	});

	// Whether node, or something it's in, scrolls vertically and has more to show, as
	// a theme can make a card's description do.
	function scrollsVertically(node) {
	  for (; node && node !== app; node = node.parentElement) {
	    if (node.scrollHeight > node.clientHeight && /auto|scroll/.test(getComputedStyle(node).overflowY)) return true;
	  }
	  return false;
	}

	// A mouse wheel only scrolls vertically; turn that into sideways scrolling of the row,
	// or of a card's actions when they don't fit. Over anything that scrolls
	// vertically, it's left alone.
	app.addEventListener("wheel", event => {
	  const actions = event.target.closest?.(".actions");
	  const row = actions && actions.scrollWidth > actions.clientWidth ? actions : app.querySelector("ul");
	  if (!row || scrollsVertically(event.target)
	      || Math.abs(event.deltaX) > Math.abs(event.deltaY)) return;
	  row.scrollLeft += event.deltaY;
	  event.preventDefault();
	}, { passive: false });

	// tick counts down every timer on the bar: an element with data-start and data-end,
	// in milliseconds, shows the time left, rounded up to the second, as Go's timeLeft
	// does, and sets --progress on its card, from 0 at its start to 1 at its end, and
	// data-done once it's up. It runs a few times a second, and after every update, as
	// a render puts back the time left as of then.
	function tick() {
	  const now = Date.now();
	  for (const timer of app.querySelectorAll("[data-end]")) {
	    const start = +timer.dataset.start, end = +timer.dataset.end;
	    const seconds = Math.ceil(Math.max(0, end - now) / 1000);
	    const pad = n => String(n).padStart(2, "0");
	    timer.textContent = seconds >= 3600
	      ? `${Math.floor(seconds / 3600)}:${pad(Math.floor(seconds / 60) % 60)}:${pad(seconds % 60)}`
	      : `${Math.floor(seconds / 60)}:${pad(seconds % 60)}`;
	    const card = timer.closest("li");
	    if (!card) continue;
	    card.style.setProperty("--progress", end > start ? Math.min(1, Math.max(0, (now - start) / (end - start))) : 1);
	    card.toggleAttribute("data-done", seconds === 0);
	  }
	}
	setInterval(tick, 250);

	send("ready");
			</script>
		</body>
	</html>
}

// BarContent is what the bar shows: cards in a row, in the order given (see
// SortByPriority), each with its actions. fresh gives each card and action new since
// the bar last showed, by ElementID, its place among the new ones of its kind (card
// or action), for the theme's entrance animation. The row is there even when empty,
// so the last card can animate out.
templ BarContent(cards []Card, fresh map[string]int) {
	<ul id="cards">
		for _, c := range cards {
			@card(c.Frame(), c.Body(), fresh)
		}
	</ul>
	if len(cards) == 0 {
		<div class="empty">No events.</div>
	}
}

// entering is the style that gives a new card or action its place among the new
// ones.
func entering(i int) string { return fmt.Sprintf("--i: %d", i) }

// card is a card's frame around its body: × if it can be dismissed, then the body,
// then its actions.
templ card(f Frame, body templ.Component, fresh map[string]int) {
	<li
		id={ f.ElementID() }
		class={ f.classes() }
		if f.Click != nil {
			data-click={ f.clickID() }
		}
		if color, ok := f.color(); ok {
			data-color={ color }
		}
		if _, ok := fresh[f.ElementID()]; ok {
			data-new
		}
		if style := f.style(fresh); style != "" {
			style={ templ.SafeCSS(style) }
		}
	>
		if f.Dismiss != nil {
			<button class="dismiss clickable" title="Dismiss" data-click={ f.dismissID() }>×</button>
		}
		@body
		<div class="actions">
			for _, q := range f.Actions {
				@action(q, fresh)
			}
		</div>
	</li>
}

// basicBody is a Basic card's body: its title and description.
templ basicBody(b Basic) {
	<span class="title">{ b.Title }</span>
	if b.Description != "" {
		<div class="description">{ b.Description }</div>
	}
}

// timerBody is a Timer's body: its title, and left, the time it has left as of when
// it's rendered. The page counts it down from its start and end, in milliseconds.
templ timerBody(t Timer, left string) {
	<span class="title">{ t.Title }</span>
	<div class="time-left" data-start={ fmt.Sprint(t.Start.UnixMilli()) } data-end={ fmt.Sprint(t.End.UnixMilli()) }>{ left }</div>
}


// action is a label. One with a Click is itself the button.
templ action(q Action, fresh map[string]int) {
	<div
		id={ q.ElementID() }
		class={ "action", templ.KV("clickable", q.Click != nil) }
		if i, ok := fresh[q.ElementID()]; ok {
			data-new
			style={ templ.SafeCSS("--action: " + cssColor(q.Color) + "; " + entering(i)) }
		} else {
			style={ templ.SafeCSS("--action: " + cssColor(q.Color)) }
		}
		data-color={ q.Color }
		if q.Click != nil {
			data-click={ q.clickID() }
		}
	>
		<span class="label">{ q.Title }</span>
	</div>
}
