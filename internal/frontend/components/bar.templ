package components

// BarPage is the bar's page, styled by themeCSS (a theme.Theme's Bar), for a bar
// along edge: "top" or "bottom". Its #app is empty until it's given BarContent: it
// posts {action: "ready"} once loaded, and from then takes update(html), with html
// rendered from BarContent, and morphs what it shows into it: only what's changed is
// touched, so a card or action that's still there keeps its element, hover and
// scroll. Its layout is page/bar.css, and its script page/bar.js.
//
// The page posts to window.webkit.messageHandlers.ledge only {action: "click", id}
// when something clickable is clicked: a card, its ×, or an action. The id is
// the one Clicks has for its Click; the page never holds anything but ids.
templ BarPage(themeCSS string, edge string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			@style(barCSS)
			@style(themeCSS)
		</head>
		<body class={ edge }>
			<div id="app"></div>
			@script(idiomorph)
			@script(barJS)
		</body>
	</html>
}

// BarContent is what the bar shows: cards in a row, in the order given. fresh gives
// each card new since the bar last showed, by ElementID, its place among the new
// ones, for the theme's entrance animation. The row is there even when empty, so the
// last card can animate out.
templ BarContent(cards []Card, fresh map[string]int) {
	<ul id="cards">
		for _, c := range cards {
			@card(c.Frame(), c.Body(), fresh)
		}
	</ul>
	if len(cards) == 0 {
		<div class="empty">No events.</div>
	}
}

// card is a card's frame around its body: its buttons, ⋯ if it has actions and × if
// it can be dismissed, then the body. One with actions has data-menu, its element
// id, for a right-click on it, or a click on its ⋯, to ask for its menu.
templ card(f Frame, body templ.Component, fresh map[string]int) {
	<li
		id={ f.ElementID() }
		class={ f.classes() }
		if f.Click != nil {
			data-click={ f.clickID() }
		}
		if len(f.Actions) > 0 {
			data-menu={ f.ElementID() }
		}
		if color, ok := f.color(); ok {
			data-color={ color }
		}
		if _, ok := fresh[f.ElementID()]; ok {
			data-new
		}
		if style := f.style(fresh); style != "" {
			style={ templ.SafeCSS(style) }
		}
	>
		if len(f.Actions) > 0 || f.Dismiss != nil {
			<div class="card-buttons">
				if len(f.Actions) > 0 {
					<button class="menu clickable" title="Actions" data-menu={ f.ElementID() }>⋯</button>
				}
				if f.Dismiss != nil {
					<button class="dismiss clickable" title="Dismiss" data-click={ f.dismissID() }>×</button>
				}
			</div>
		}
		@body
	</li>
}
