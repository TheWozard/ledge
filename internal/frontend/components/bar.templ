package components

// BarPage is the bar's page, styled by themeCSS (a theme.Theme's Bar), for a bar
// along edge: "top" or "bottom". Its #app is empty until it's given BarContent: it
// posts {action: "ready"} once loaded, and from then takes update(html), with html
// rendered from BarContent, and morphs what it shows into it: only what's changed is
// touched, so a card or action that's still there keeps its element, hover and
// scroll. Its layout is page/bar.css, and its script page/bar.js.
//
// The page posts to window.webkit.messageHandlers.ledge only {action: "click", id,
// event} when something clickable is clicked, with the main or middle button: a
// card, its ×, or a part of it. The id is the one ClickID gave out for its Click, and
// event is how it was clicked, {alt, cmd, shift, ctrl, middle}; the page never holds
// anything but ids; a card's ⋯, and a right-click on it, is a click that shows its
// menu. It also posts {action: "ready"} once loaded. Its script starts with
// page/ledge.js, as every page's does.
templ BarPage(themeCSS string, edge string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			@style(barCSS)
			@style(themeCSS)
		</head>
		<body class={ edge }>
			<div id="app"></div>
			@script(idiomorph)
			@script(ledgeJS)
			@script(barJS)
		</body>
	</html>
}

// BarContent is what the bar shows: cards in a row, in the order given. The row is
// there even when empty, so the last card can animate out. Which cards are new, for
// the theme's entrance animation, is the page's to tell. menu gives the Click that
// shows the menu of a card with actions, from its frame, for its ⋯ and a right-click
// on it; with a nil menu, a card's menu goes nowhere.
templ BarContent(cards []Card, menu func(f Frame) Click) {
	<ul id="cards">
		for _, c := range cards {
			@card(c.Frame(), c.Body(), menu)
		}
	</ul>
	if len(cards) == 0 {
		<div class="empty">No events.</div>
	}
}

// frame is card's frame, rendered in its scope, with showMenu the Click that shows
// its menu.
templ frame(f Frame, body templ.Component, showMenu Click) {
	<li
		id={ f.ElementID() }
		class={ f.classes() }
		if f.Click != nil {
			data-click={ ClickID(ctx, "click", f.Click) }
		}
		if len(f.Actions) > 0 {
			data-menu={ ClickID(ctx, "menu", showMenu) }
		}
		if color, ok := f.color(); ok {
			data-color={ color }
		}
		if style := f.style(); style != "" {
			style={ templ.SafeCSS(style) }
		}
	>
		if len(f.Actions) > 0 || f.Dismiss != nil {
			<div class="card-buttons">
				if len(f.Actions) > 0 {
					<button class="menu clickable" title="Actions" data-click={ ClickID(ctx, "menu", showMenu) }>⋯</button>
				}
				if f.Dismiss != nil {
					<button class="dismiss clickable" title="Dismiss" data-click={ ClickID(ctx, "dismiss", f.Dismiss) }>×</button>
				}
			</div>
		}
		@inScope(scope{"body", f.ID}, body)
	</li>
}
