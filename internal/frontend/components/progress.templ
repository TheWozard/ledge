package components

import (
	"fmt"
	"math"
)

// Progress is a Basic card that shows how far along something is, such as a deploy's
// steps or a download: its title, then how far along it is, with its description
// beside it. Its kind is "progress". The card has --progress, its Value, for a theme
// to fill it; the app renders it again as it moves.
type Progress struct {
	Basic
	Value float64 // how far along it is, from 0 to 1
	Label string  // shown in place of the percent, such as "3/5"; "" for the percent
}

// Frame is the frame of the progress card's Basic card, of the kind "progress", with
// its Value.
func (p Progress) Frame() Frame {
	f := p.Basic.Frame()
	f.Kind, f.Progress = "progress", p.Value
	return f
}

// Body is the card's title, then its Label, or its Value as a percent, with its
// description beside it.
func (p Progress) Body() templ.Component {
	shown := p.Label
	if shown == "" {
		shown = percent(p.Value)
	}
	return progressBody(p, shown)
}

// percent is value, from 0 to 1, as a percent, rounded down so it's never done early:
// "60%".
func percent(value float64) string {
	if !(value > 0) { // NaN too
		return "0%"
	}
	return fmt.Sprintf("%d%%", int(math.Floor(min(value, 1)*100)))
}

// progressBody is a Progress's body: its title, then a row of shown, how far along it
// is, and its description beside it.
templ progressBody(p Progress, shown string) {
	<span class="title">{ p.Title }</span>
	<div class="reading">
		<div class="reading-value">{ shown }</div>
		if p.Description != "" {
			<div class="description">{ p.Description }</div>
		}
	</div>
}
